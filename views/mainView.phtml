        <?php
        
    $categoryNames = [];
    foreach($categories as $category) {
        $categoryNames[$category->getId()] = $category->getName();
    }
    ?>
    <ul>
    <?php
    foreach($tasks as $task) {
        echo "<li>";
        echo $task->getDone() ? "<s>".htmlspecialchars($task->getTitle())."</s> — Realizada" : htmlspecialchars($task->getTitle())." — Pendiente";
        echo " | ".htmlspecialchars($task->getDate());
                if ($task->getCategoryId() && isset($categoryNames[$task->getCategoryId()])) {
            echo " | Categoría: ".htmlspecialchars($categoryNames[$task->getCategoryId()]);
        } else {
            echo " | Sin categoría";
        }
        echo " | <a href='index.php?c=task&a=toggle&id=".$task->getId()."'>Cambiar estado</a>";
        echo " | <a href='index.php?c=task&a=delete&id=".$task->getId()."'>Eliminar</a>";
        echo " | <form action='index.php?c=task&a=add_user' method='POST' style='display:inline'>
                <input type='hidden' name='task_id' value='".$task->getId()."'>
                <input type='text' name='username' placeholder='Usuario' required>
                <button type='submit'>Compartir</button>
               </form>";
                       echo " | <form action='index.php?c=task&a=set_category' method='POST' style='display:inline'>";
        echo "<input type='hidden' name='task_id' value='".$task->getId()."'>";
        echo "<select name='category_id'>";
        echo "<option value=''>Sin categoría</option>";
        foreach($categories as $category) {
            $selected = ($task->getCategoryId() == $category->getId()) ? " selected" : "";
            echo "<option value='".$category->getId()."'".$selected.">".htmlspecialchars($category->getName())."</option>";
        }
        echo "</select>";
        echo "<button type='submit'>Asignar</button>";
        echo "</form>";
        echo "</li>";
    }
    ?>
    </ul>

