      <?php
    foreach($sharedTasks as $shared) {
        echo "<li>";
        echo $shared->getDone() ? "<s>".htmlspecialchars($shared->getTitle())."</s> — Realizada" : htmlspecialchars($shared->getTitle())." — Pendiente";
        echo " | ".htmlspecialchars($shared->getDate());
